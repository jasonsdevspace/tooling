{
    "name": "tooling",
    "private": true,
    "description": "The repository for the build tools Jason Poteet's repositories share.",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=24 <25"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "type-check": "tsc --noEmit && tsc -p scripts && tsc -p packages/prose-check",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prose": "check-prose",
        "node-check": "node scripts/check-node.mjs",
        "test": "vitest",
        "test:run": "vitest run",
        "verify": "npm run type-check && npm run lint && npm run format:check && npm run prose && npm run node-check && npm run test:run",
        "prepare": "husky || true"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.19.2",
        "eslint": "^10.14.0",
        "eslint-plugin-import-x": "^4.18.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-sonarjs": "^4.2.2",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.10.1",
        "publint": "^0.3.25",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.2",
        "vitest": "^5.1.0"
    },
    "lint-staged": {
        "*.{ts,js,mjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "allowScripts": {
        "fsevents": true
    }
}
