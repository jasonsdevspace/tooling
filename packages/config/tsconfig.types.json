{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": false,
        "declaration": true,
        "emitDeclarationOnly": true,
        "stripInternal": true,
        "rootDir": "src",
        "outDir": "types",
        "skipLibCheck": true
    },
    "include": ["src/*.mjs"]
}
