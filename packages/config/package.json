{
    "name": "@jasonsdevspace/config",
    "version": "0.1.0",
    "description": "The house's shared lint, format and TypeScript settings: ESLint presets for any code, type-aware rules, tests and React hooks, the Prettier config and a strict TypeScript base.",
    "keywords": [
        "eslint-config",
        "prettier-config",
        "tsconfig",
        "eslint",
        "prettier",
        "typescript"
    ],
    "license": "MIT",
    "author": "Jason Poteet",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jasonsdevspace/tooling.git",
        "directory": "packages/config"
    },
    "homepage": "https://github.com/jasonsdevspace/tooling/tree/main/packages/config#readme",
    "bugs": {
        "url": "https://github.com/jasonsdevspace/tooling/issues"
    },
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=24"
    },
    "exports": {
        "./eslint": {
            "types": "./types/eslint.d.mts",
            "default": "./src/eslint.mjs"
        },
        "./react": {
            "types": "./types/react.d.mts",
            "default": "./src/react.mjs"
        },
        "./prettier": {
            "types": "./types/prettier.d.mts",
            "default": "./src/prettier.mjs"
        },
        "./tsconfig.json": "./tsconfig.base.json",
        "./package.json": "./package.json"
    },
    "files": [
        "src/*.mjs",
        "types",
        "tsconfig.base.json"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "types": "tsc -p tsconfig.types.json"
    },
    "peerDependencies": {
        "eslint": "^10.0.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "prettier": "^3.0.0",
        "typescript": ">=6.0.0",
        "typescript-eslint": "^8.74.0"
    },
    "peerDependenciesMeta": {
        "eslint-plugin-react-hooks": {
            "optional": true
        },
        "prettier": {
            "optional": true
        }
    },
    "dependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
        "@eslint/js": "10.0.1",
        "eslint-plugin-import-x": "4.18.1",
        "eslint-plugin-simple-import-sort": "14.0.0",
        "eslint-plugin-sonarjs": "4.2.3",
        "globals": "17.14.0"
    }
}
