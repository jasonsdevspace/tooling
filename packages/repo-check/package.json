{
    "name": "@jasonsdevspace/repo-check",
    "version": "0.1.0",
    "description": "Fails a build wherever npm could run install scripts or fetch git or URL dependencies: a package root whose .npmrc lacks the settings that stop them, a flag, setting or command that gives one another value, an unset Dockerfile stage, an install outside the project, or a tool fetched to run.",
    "keywords": [
        "npm",
        "install-scripts",
        "ignore-scripts",
        "npmrc",
        "dockerfile",
        "supply-chain"
    ],
    "license": "MIT",
    "author": "Jason Poteet",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jasonsdevspace/tooling.git",
        "directory": "packages/repo-check"
    },
    "homepage": "https://github.com/jasonsdevspace/tooling/tree/main/packages/repo-check#readme",
    "bugs": {
        "url": "https://github.com/jasonsdevspace/tooling/issues"
    },
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=24.18"
    },
    "bin": {
        "check-installs": "./bin/check-installs.mjs"
    },
    "exports": {
        ".": {
            "types": "./types/index.d.mts",
            "default": "./src/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "bin",
        "src/*.mjs",
        "types"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "types": "tsc -p tsconfig.types.json"
    }
}
