{
    "name": "tooling",
    "private": true,
    "description": "The repository for the build tools Jason Poteet's repositories share.",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=24 <25"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "type-check": "tsc --noEmit && tsc -p scripts && tsc -p packages/prose-check && tsc -p packages/repo-check && tsc -p packages/config",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prose": "check-prose",
        "installs": "check-installs",
        "node-check": "node scripts/check-node.mjs",
        "test": "vitest",
        "test:run": "vitest run",
        "verify": "npm run type-check && npm run lint && npm run format:check && npm run prose && npm run installs && npm run node-check && npm run test:run",
        "prepare": "husky || true"
    },
    "devDependencies": {
        "@types/node": "24.19.4",
        "eslint": "10.16.0",
        "husky": "9.1.7",
        "lint-staged": "17.6.2",
        "prettier": "3.10.1",
        "publint": "0.3.25",
        "typescript": "6.0.3",
        "typescript-eslint": "8.74.0",
        "vitest": "5.1.2"
    },
    "prettier": "@jasonsdevspace/config/prettier",
    "lint-staged": {
        "*.{ts,js,mjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    }
}
